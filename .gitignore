# ── 依赖 ──
node_modules/

# ── 构建产物（electron-builder）──
release/
dist/
out/

# ── 缓存（pnpm/npm/electron，已重定向到项目内）──
.pnpm-store/
.npm-cache/
.electron-cache/
.cache/
.parcel-cache/
.eslintcache/
*.tsbuildinfo
*.tgz

# ── 日志 ──
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 环境变量 / 密钥（绝不能提交）──
.env
.env.*
!.env.example
.credentials.yaml

# ── DSH 测试 / harness home 目录 ──
.dsh/
.dsh-smoke/

# ── 其它包管理器的锁文件（本项目用 pnpm，只提交 pnpm-lock.yaml）──
package-lock.json
yarn.lock

# ── 测试 / 覆盖率 ──
coverage/
.nyc_output/

# ── 系统 / 编辑器垃圾 ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
