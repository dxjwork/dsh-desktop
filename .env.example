# 复制本文件为 .env 并按需填写；.env 已被 .gitignore 忽略，不会提交。

# DeepSeek API Key（余额查询用）。
# 未设置时，桌面端默认读 dsh web 服务已配置的 key（$DSH_HOME/.credentials.yaml）。
# DEEPSEEK_API_KEY=sk-...

# DeepSeek API Base URL（可选，默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Harness home（可选，默认 ~/.dsh）
# DSH_HOME=C:\Users\<you>\.dsh

# 本机有代理 / 自签名 CA 时，让 Node 使用系统证书库（安装与余额请求都需要）
# NODE_OPTIONS=--use-system-ca
